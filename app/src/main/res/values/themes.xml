<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- White window background so the native shell matches the light
         Compose UI with no flash. System bars are drawn edge-to-edge and
         styled from Compose (MainActivity). -->
    <style name="Theme.TeluguPanchangam" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
